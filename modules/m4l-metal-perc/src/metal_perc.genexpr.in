// =====================================================================
// m4l-metal-perc – metallischer Percussion-Generator mit Step-Sequencer
// gen~ Codebox (GenExpr). Diese Datei wird von build.py erzeugt:
// Quelle ist src/metal_perc.genexpr.in – dort editieren, nicht hier.
//
// Eingänge  (Signal, Konvention: ±1.0 = ±5 V)
//   in1  Host-Beat-Phase (plugphasor~, 0..1 pro Beat)
//   in2  Ext Clock (steigende Flanke = 1 Step)
//   in3  Ext Reset (steigende Flanke)
//   in4  Pitch CV, 1 V/Oct (0.2 = 1 Oktave), wird beim Trigger gehalten
//   in5  Ext Trigger (spielt die Voice direkt, unabhängig vom Sequencer)
// Ausgänge
//   out1 Audio
//   out2 Hüllkurve (0..1)
//   out3 aktueller Step (0..15)
//   out4 Gate/Trigger-Out (5 ms)
// =====================================================================

// ---------- Hilfsfunktionen ----------
blep(t, dt) {
	r = 0;
	if (t < dt) {
		x = t / dt;
		r = x + x - x * x - 1;
	} else if (t > 1 - dt) {
		x = (t - 1) / dt;
		r = x * x + x + x + 1;
	}
	return r;
}

// w: 0 Sine, 1 Square/Pulse (Breite pw), 2 Saw, 3 Triangle (bandbegrenzt via polyBLEP)
osc(p, dt, w, pw) {
	y = 0;
	if (w < 0.5) {
		y = sin(twopi * p);
	} else if (w < 1.5) {
		sq = 1;
		if (p >= pw) {
			sq = -1;
		}
		y = sq + blep(p, dt) - blep(fract(p + 1 - pw), dt) - (2 * pw - 1);
	} else if (w < 2.5) {
		y = 2 * p - 1 - blep(p, dt);
	} else {
		y = 4 * abs(p - 0.5) - 1;
	}
	return y;
}

// Nächstliegende Note in der Skala (mask = 12-Bit-Maske ab Grundton)
quant(n, root, mask) {
	base = floor(n + 0.5);
	best = base;
	bestd = 100;
	for (k = -6; k <= 6; k += 1) {
		cand = base + k;
		deg = cand - root;
		deg = deg - floor(deg / 12) * 12;
		bit = floor(mask / pow(2, deg));
		bit = bit - floor(bit / 2) * 2;
		d = abs(cand - n);
		if (bit > 0.5 && d < bestd) {
			best = cand;
			bestd = d;
		}
	}
	return best;
}

// TPT-State-Variable-Filter mit optionaler OTA-Sättigung der Eingangsstufe (sat > 0).
// mode 0 Lowpass, 1 Bandpass (unity peak), 2 Highpass. Zustände in Data st an i, i+1.
svf(x, fc, q, sr, st, i, mode, sat) {
	g = tan(pi * min(fc, sr * 0.49) / sr);
	k = 1 / q;
	a1 = 1 / (1 + g * (g + k));
	a2 = g * a1;
	a3 = g * a2;
	ic1 = peek(st, i);
	ic2 = peek(st, i + 1);
	v3 = x - ic2;
	if (sat > 0.001) {
		v3 = tanh(v3 * sat) / sat;
	}
	v1 = a1 * ic1 + a2 * v3;
	v2 = ic2 + a2 * ic1 + a3 * v3;
	poke(st, 2 * v1 - ic1, i);
	poke(st, 2 * v2 - ic2, i + 1);
	y = v2;
	if (mode > 1.5) {
		y = x - k * v1 - v2;
	} else if (mode > 0.5) {
		y = v1 * k;
	}
	return y;
}

// Pseudozufall 0..1 aus Seed und Index (Bauteil-Toleranzen pro Device-Instanz)
rnd_hash(sd, i) {
	return wrap(sin(sd * 12.9898 + i * 78.233 + 0.5) * 43758.5453, 0, 1);
}

// ---------- Analoge Filter-Schaltungen (Konzepte wie die Circuit-Typen in Abletons Auto Filter) ----------
// Ein-Pol-Tiefpass (TPT/ZDF), G = g / (1 + g), Zustand in d[i]
op1(x, G, d, i) {
	s = peek(d, i);
	v = (x - s) * G;
	y = v + s;
	poke(d, y + v, i);
	return y;
}

// Ausgang LP/BP/HP/Notch/Morph aus den Teilsignalen; Morph blendet LP -> BP -> HP -> Notch -> LP
flt_out(lp, bp, hp, mo, mph) {
	y = lp;
	if (mo > 4.5) {
		m4 = clamp(mph, 0, 1) * 4;
		seg = min(floor(m4), 3);
		fr = m4 - seg;
		ya = selector(seg + 1, lp, bp, hp, lp + hp);
		yb = selector(seg + 1, bp, hp, lp + hp, lp);
		y = mix(ya, yb, fr);
	} else if (mo > 3.5) {
		y = lp + hp;
	} else if (mo > 2.5) {
		y = hp;
	} else if (mo > 1.5) {
		y = bp;
	}
	return y;
}

// State-Variable-Filter 12 dB mit Begrenzung des Resonanz-(Bandpass-)Zustands:
// lim 0 = Clean, 1 = harte Diodenbegrenzung (OSR-Prinzip), 2 = weiche Begrenzung (MS2-/Sallen-Key-Prinzip).
// sat > 0: OTA-Sättigung der Eingangsstufe. Zustände in d[i], d[i+1].
svf_lim(x, g, k, d, i, mo, lim, mph, sat) {
	a1 = 1 / (1 + g * (g + k));
	a2 = g * a1;
	a3 = g * a2;
	ic1 = peek(d, i);
	ic2 = peek(d, i + 1);
	v3 = x - ic2;
	if (sat > 0.001) {
		v3 = tanh(v3 * sat) / sat;
	}
	v1 = a1 * ic1 + a2 * v3;
	v2 = ic2 + a2 * ic1 + a3 * v3;
	n1 = 2 * v1 - ic1;
	if (lim > 1.5) {
		n1 = tanh(n1 / 3) * 3;
	} else if (lim > 0.5) {
		n1 = clamp(n1, -2, 2);
	}
	poke(d, n1, i);
	poke(d, 2 * v2 - ic2, i + 1);
	return flt_out(v2, v1 * k, x - k * v1 - v2, mo, mph);
}

// Transistor-Ladder 24 dB (PRD-Prinzip: keine Resonanzbegrenzung, kann selbst oszillieren).
// soft = 1: Hybrid (SMP-Prinzip) mit weich begrenzter Rückkopplung und 18-dB-artigem Ausgang.
// Zustände in d[i] .. d[i+3], letzter Ausgang in d[i+4].
ladder(x, G, kfb, d, i, mo, soft, mph) {
	fb = peek(d, i + 4);
	if (soft > 0.5) {
		fb = tanh(fb * 1.5) / 1.5;
	}
	u = tanh(x - kfb * fb);
	y1 = op1(u, G, d, i);
	y2 = op1(y1, G, d, i + 1);
	y3 = op1(y2, G, d, i + 2);
	y4 = op1(y3, G, d, i + 3);
	poke(d, y4, i + 4);
	lp = y4 * (1 + kfb * 0.15);
	hp = u - 4 * y1 + 6 * y2 - 4 * y3 + y4;
	bp = 4 * (y2 - 2 * y3 + y4);
	if (soft > 0.5) {
		lp = 0.5 * (y2 + y4) * (1 + kfb * 0.1);
		hp = 0.5 * ((u - 2 * y1 + y2) + hp);
	}
	return flt_out(lp, bp, hp, mo, mph);
}

// Weiche Diodenkennlinie: sperrt unter ~0.2, dann quadratischer Übergang, dann linear
diode(v) {
	u = v - 0.2;
	r = 0;
	if (u > 0) {
		r = u * u / (u + 0.2);
	}
	return r;
}

// Dioden-Ringmodulator (4 Dioden), skaliert auf ~c*m bei kleinen Pegeln
diode_ring(c, m) {
	return (diode(c + m) + diode(-c - m) - diode(c - m) - diode(m - c)) * 1.25;
}

// ---------- Parameter: Voice ----------
Param tune(56, min=24, max=96);       // Basis-Note (MIDI)
Param waveform(1, min=0, max=3);          // 0 Sine 1 Square 2 Saw 3 Tri
Param morph(0, min=0, max=1);         // 0 Bank -> 0.5 FM/Ring -> 1 Resonator
Param inharm(0.5, min=0, max=1);      // 0 harmonisch -> 0.5 808-Metall -> 1 Membran/Glocke
Param attack(0.5, min=0.1, max=50);   // ms, weicher Anschlag gegen Klicks
Param decay(0.3, min=0, max=1);       // 10 ms .. 2.5 s
Param damp(0.5, min=0, max=1);        // Resonator-Dämpfung
Param bright(0.6, min=0, max=1);      // Filter/FM-Index
Param drive(0.2, min=0, max=1);
Param noise_mix(0.05, min=0, max=1);

// ---------- Parameter: Oszillatoren ----------
Param voices(6, min=1, max=6);        // aktive Bank-Oszillatoren
Param spread(1, min=0, max=2);        // Abstand der Verhältnisse (0 = alle auf f0)
Param detune(0, min=0, max=50);       // Verstimmung der Bank in Cent
Param tilt(0, min=-1, max=1);         // Pegel der oberen Partials (- dunkel, + hell)
Param pw(0.5, min=0.05, max=0.95);    // Pulsbreite (Square)
Param fm_ratio(1.4142, min=0.5, max=8);
Param fm_amt(0.36, min=0, max=1);     // FM-Index
Param fm_fb(0, min=0, max=1);         // Modulator-Feedback
Param ring(0.4, min=0, max=1);        // Mischung FM-Träger <-> Ringmodulation
Param mod_wave(1, min=0, max=3);      // Wellenform des Modulators
Param sweep(0, min=-24, max=48);      // Pitch-Hüllkurve in Halbtönen
Param sweep_time(30, min=1, max=500);   // ms
Param retrig(0, min=0, max=1);        // 0 Phasen frei, 1 Reset bei jedem Schlag
Param fm_mode(0, min=0, max=1);       // 0 linear (Phasenmodulation), 1 exponentiell (analog)
Param ring_bleed(0.15, min=0, max=1); // Durchschlag + Verzerrung des Dioden-Rings

// ---------- Parameter: Circuit ----------
Param wfold(0, min=0, max=1);          // Wavefolder
Param asym(0.25, min=0, max=1);       // asymmetrische Sättigung (gerade Obertöne)
Param amp_mode(0, min=0, max=1);      // 0 VCA, 1 Lowpass-Gate (Vactrol)
Param lpg_color(0.6, min=0, max=1);   // Filteranteil des Lowpass-Gates
Param reso_mode(0, min=0, max=1);     // 0 Modal, 1 Bridged-T (808-Prinzip)

// ---------- Parameter: Analog ----------
Param analog(0.5, min=0, max=1);      // Makro: Drift, Toleranz, Jitter, Bleed, Rauschen
Param age(0.3, min=0, max=1);         // Clean -> Vintage -> Worn
Param sag(0.25, min=0, max=1);        // Netzteil-Einbruch bei lauten Schlägen
Param hum(0, min=0, max=1);           // Brumm
Param hum_hz(0, min=0, max=1);        // 0 = 50 Hz, 1 = 60 Hz
Param seed(1, min=0, max=999);        // Charakter dieser Instanz
Param quality(1, min=0, max=2);       // Oversampling 1x / 2x / 4x

// ---------- Parameter: Filter ----------
Param flt_type(0, min=0, max=5);      // 0 Off, 1 LP, 2 BP, 3 HP, 4 Notch, 5 Morph
Param cutoff(2000, min=20, max=18000); // Hz
Param reso(0.2, min=0, max=1);
Param flt_env(0, min=-1, max=1);      // Mod-Hüllkurve -> Cutoff, ±6 Oktaven
Param key_trk(0, min=0, max=1);       // Cutoff folgt der Tonhöhe (1 = 100 %)
Param flt_circ(0, min=0, max=4);      // 0 Clean, 1 OSR, 2 MS2, 3 SMP, 4 PRD
Param flt_slope(0, min=0, max=1);     // nur Clean: 0 = 12 dB, 1 = 24 dB
Param flt_drive(0, min=0, max=1);     // Pegel in die Filterschaltung
Param flt_morph(0, min=0, max=1);     // Filtertyp Morph: LP -> BP -> HP -> Notch -> LP

// ---------- Parameter: Dirt ----------
Param dist_type(0, min=0, max=5);     // 0 Off, 1 Diode, 2 Tube, 3 Fuzz, 4 Rectify, 5 Foldback
Param dist_drive(0.4, min=0, max=1);
Param dist_tone(0.7, min=0, max=1);   // Tiefpass nach der Verzerrung, 500 Hz .. 18 kHz
Param dist_mix(1, min=0, max=1);
Param crush_bits(16, min=2, max=16);  // 16 = aus
Param crush_rate(48000, min=200, max=48000); // Hz (Sample & Hold), Maximum = aus
Param fb_amt(0, min=0, max=1);        // Feedback-Patch: Ausgang zurück in FM und/oder Filter
Param fb_tone(0.5, min=0, max=1);     // Tiefpass im Feedback-Weg, 200 Hz .. 12 kHz
Param fb_dest(0, min=0, max=2);       // 0 FM, 1 Filter, 2 beide
Param sync(0, min=0, max=1);          // Hard Sync: 0 aus, sonst Slave-Verhältnis 1..8
Param flt_fm(0, min=0, max=1);        // Filter-FM im Audiotakt durch den Modulator, bis ±4 Oktaven

// ---------- Parameter: Rumble ----------
Param rmb_send(0, min=0, max=1);      // 0 = aus (spart CPU)
Param rmb_decay(0.5, min=0, max=1);   // Nachhall 1 .. 10 s
Param rmb_drive(0.5, min=0, max=1);
Param rmb_lp(150, min=40, max=500);   // Hz
Param rmb_duck(0.6, min=0, max=1);    // Ducking durch die Hüllkurve des Schlags

// ---------- Parameter: Mod-Hüllkurve ----------
Param menv_atk(2, min=0.1, max=500);  // ms
Param menv_dec(150, min=5, max=3000); // ms
Param menv_curve(0.6, min=0, max=1);  // 0 linear, 1 stark exponentiell
Param menv_loop(0, min=0, max=1);     // 0 einmal, 1 Loop (AD-Zyklus läuft durch)
Param menv_pitch(0, min=-24, max=24); // Halbtöne
Param menv_fm(0, min=-1, max=1);      // zusätzlicher FM-Index
Param menv_fold(0, min=0, max=1);     // zusätzlicher Fold
Param accent(0.5, min=0, max=1);      // Velocity -> Decay/Helligkeit
Param level(0.8, min=0, max=1);

// ---------- Parameter: Pitch / Quantizer ----------
Param qmode(1, min=0, max=1);         // 0 Loose, 1 Scale
Param scale_sel(1, min=0, max=7);
Param root(0, min=0, max=11);

// ---------- Parameter: Sequencer ----------
Param seq_on(1, min=0, max=1);
Param clock_mode(0, min=0, max=2);    // 0 Host, 1 Ext Clock, 2 Intern
Param bpm(130, min=40, max=300);
Param clock_div(1, min=0, max=4);           // 1/8, 1/16, 1/32, 1/8T, 1/16T
Param seq_len(16, min=1, max=16);
Param reset_id(0);
Param rtrg_rate(1, min=0, max=4);     // Retrig-Schläge pro Step: 2, 3, 4, 6, 8
Param rtrg_len(1, min=0.25, max=8);   // Retrig-Länge in Steps
Param rtrg_vel(-0.5, min=-1, max=1);  // Velocity-Verlauf: - ausblenden, + einblenden

// ---------- Parameter: Live-Randomisierung ----------
Param live_steps(0, min=0, max=1);
Param live_vel(0, min=0, max=1);
Param live_pitch(0, min=0, max=1);
Param density(0.6, min=0, max=1);
Param vel_range(0.5, min=0, max=1);
Param pitch_range(7, min=0, max=24);

// ---------- Parameter: MIDI ----------
Param midi_id(0);
Param midi_note(60);
Param midi_vel(0);

// ---------- Parameter: Steps ----------
@STEP_PARAMS@

// ---------- Zustand ----------
History beats(0);
History last_phase(-1);
History still(0);
History int_phase(0);
History ext_count(0);
History clk_prev(0);
History rst_prev(0);
History trg_prev(0);
History last_reset(0);
History last_midi(0);
History last_step(-1);
History step_samps(5512);   // Länge eines Steps in Samples (gemessen bzw. berechnet)
History clk_cnt(0);
History rt_arm(0);
History rt_on(0);
History rt_cnt(0);
History rt_next(0);
History rt_total(0);
History rt_int(0);
History rt_vel(1);
History rt_note(56);
History me_lin(0);   // Mod-Hüllkurve: linearer Verlauf 0..1
History me_stage(0); // 0 aus, 1 Attack, 2 Decay
History env(0);
History att(0);
History target(0);
History coef(0.999);
History exc(0);
History pe(0);
History fb_prev(0);
History hit_note(56);
History hit_vel(1);
History gate_cnt(0);
History dc_y(0);   // Ausgang nach dem Koppel-Hochpass
History pend(0);
History p_note(56);
History p_vel(1);
History vac(0);
History sagf(0);
History bt_amp(0);
History hum_ph(0);
History pk0(0);
History pk1(0);
History pk2(0);
History last_seed(-1);
Data ph(8);     // Phasen: 0-5 Bank, 6 Träger, 7 Modulator
Data osl(8);    // Slew-Zustände der Oszillatoren
Data dr(9);     // Drift: 0-7 Oszillatoren, 8 global
Data fq(8);
Data slc(8);    // Slew-Koeffizient pro Oszillator     // Frequenz-Faktor pro Oszillator (Toleranz, Drift, Jitter)
Data tol(40);   // Toleranzen: [i] Cent, [8+i] PW, [16+i] DC, [24+i] Slew, [32+j] Moden/Filter
Data st(26);    // Filterzustände
Data fst(12);   // Zustände des Multimode-Filters
Data aux(16);   // 0 Dist-Tone, 1 Feedback-Weg, 2 Rumble-Eingang, 3-6 Rumble-Dämpfung, 7-10 Rumble-Tiefpass
Data rvb(32768); // Rumble: 4 Delay-Linien à 8192 Samples
History sm_ph(0);   // Sync-Master für den FM-Träger
History cr_ph(0);
History cr_hold(0);
History rw(0);

// ---------- Clock ----------
spb = selector(floor(clock_div) + 1, 2, 4, 8, 3, 6);  // Steps pro Beat
len = floor(seq_len);

if (reset_id != last_reset) {
	last_reset = reset_id;
	beats = 0;
	int_phase = 0;
	ext_count = 0;
	last_step = -1;
}
rst = in3 > 0.1;
if (rst && rst_prev < 0.5) {
	beats = 0;
	int_phase = 0;
	ext_count = 0;
	last_step = -1;
}
rst_prev = rst;

step_abs = -1;
if (clock_mode < 0.5) {
	phs = in1;
	// Transport-Stopp erkennen: Phase steht > 50 ms -> beim Weiterlaufen neu ab Step 1
	if (phs == last_phase) {
		still = still + 1;
	} else {
		if (still > samplerate * 0.05) {
			beats = 0;
			last_step = -1;
		} else if (phs < last_phase - 0.5) {
			beats = beats + 1;
		} else if (phs > last_phase) {
			step_samps = 1 / ((phs - last_phase) * spb);
		}
		still = 0;
	}
	last_phase = phs;
	if (still < samplerate * 0.05) {
		step_abs = floor((beats + phs) * spb);
	} else {
		step_abs = last_step;
	}
} else if (clock_mode < 1.5) {
	c = in2 > 0.1;
	clk_cnt = clk_cnt + 1;
	if (c && clk_prev < 0.5) {
		ext_count = ext_count + 1;
		step_samps = clk_cnt;
		clk_cnt = 0;
	}
	clk_prev = c;
	step_abs = ext_count - 1;
} else {
	int_phase = int_phase + bpm / 60 / samplerate;
	step_abs = floor(int_phase * spb);
	step_samps = samplerate * 60 / (bpm * spb);
}

cur_step = last_step;
fire = 0;
vel = 1;
pitch = 0;
if (step_abs >= 0) {
	cur = step_abs - floor(step_abs / len) * len;
	if (cur != last_step) {
		last_step = cur;
		cur_step = cur;
		on = @SEL_ON@;
		if (seq_on > 0.5 && on > 0.5) {
			if (live_steps < 0.5 || (noise() * 0.5 + 0.5) < density) {
				fire = 1;
				vel = @SEL_VEL@;
				pitch = @SEL_PITCH@;
				rt_arm = @SEL_RTRG@;
				if (live_vel > 0.5) {
					vel = vel * (1 - vel_range * (noise() * 0.5 + 0.5));
				}
				if (live_pitch > 0.5) {
					pitch = pitch + pitch_range * noise();
				}
			}
		}
	}
}

// MIDI-Noten (aus Live-Clips) und Ext Trigger spielen die Voice direkt
if (midi_id != last_midi) {
	last_midi = midi_id;
	if (midi_vel > 0) {
		fire = 1;
		vel = midi_vel / 127;
		pitch = midi_note - 60;
		rt_arm = 0;
	}
}
tr = in5 > 0.1;
if (tr && trg_prev < 0.5) {
	fire = 1;
	vel = 1;
	pitch = 0;
	rt_arm = 0;
}
trg_prev = tr;

// ---------- Analog-Charakter ----------
an = analog;
ag = age;
if (seed != last_seed) {
	last_seed = seed;
	for (t_i = 0; t_i < 8; t_i += 1) {
		poke(tol, rnd_hash(seed, t_i) * 2 - 1, t_i);
		poke(tol, rnd_hash(seed, t_i + 8) - 0.5, t_i + 8);
		poke(tol, rnd_hash(seed, t_i + 16) - 0.5, t_i + 16);
		poke(tol, rnd_hash(seed, t_i + 24), t_i + 24);
	}
	for (t_j = 0; t_j < 8; t_j += 1) {
		poke(tol, rnd_hash(seed, t_j + 32) * 2 - 1, t_j + 32);
	}
}
// Drift: tiefpassgefiltertes Rauschen (~0.7 Hz), auf Standardabweichung 1 normiert
d_a = 1 - exp(-twopi * (0.4 + ag * 0.8) / samplerate);
d_norm = 1 / sqrt(d_a / (2 - d_a) / 3);
for (d_i = 0; d_i < 9; d_i += 1) {
	dv = peek(dr, d_i);
	poke(dr, dv + (noise() - dv) * d_a, d_i);
}
drift_c = an * (2 + ag * 10);       // Cent (Standardabweichung)
tol_c = an * (3 + ag * 5);          // Cent
jit_c = an * (0.3 + ag);            // Cent, schnelles Pitch-Rauschen
shape_ev = an * (0.04 + ag * 0.08); // gerade Obertöne in den Wellenformen
bleed = an * (0.0003 + ag * 0.0015);
ota = an * (0.4 + ag * 0.8);

// ---------- Trigger -> Voice (mit Trigger-Jitter) ----------
start = 0;
s_note = 0;
s_vel = 0;
if (fire > 0.5) {
	note = tune + pitch + in4 * 60;
	if (qmode > 0.5) {
		mask = selector(floor(scale_sel) + 1, @SCALE_MASKS@);
		note = quant(note, root, mask);
	}
	jit = floor((noise() * 0.5 + 0.5) * an * 0.0004 * samplerate);
	if (jit < 1) {
		start = 1;
		s_note = note;
		s_vel = vel;
	} else {
		pend = jit;
		p_note = note;
		p_vel = vel;
	}
} else if (pend > 0) {
	pend = pend - 1;
	if (pend < 0.5) {
		start = 1;
		s_note = p_note;
		s_vel = p_vel;
	}
}

// Retrig (Elektron-Prinzip): ein Step mit Retrig wiederholt den Schlag rtrg_rate-fach pro Step,
// rtrg_len Steps lang, mit Velocity-Verlauf rtrg_vel. Ein neuer regulärer Schlag beendet ihn.
if (start > 0.5) {
	rt_on = 0;
	if (rt_arm > 0.5) {
		rt_on = 1;
		rt_cnt = 0;
		rt_int = step_samps / selector(floor(rtrg_rate + 0.5) + 1, 2, 3, 4, 6, 8);
		rt_next = rt_int;
		rt_total = rtrg_len * step_samps;
		rt_vel = s_vel;
		rt_note = s_note;
	}
	rt_arm = 0;
} else if (rt_on > 0.5) {
	rt_cnt = rt_cnt + 1;
	if (rt_cnt >= rt_total) {
		rt_on = 0;
	} else if (rt_cnt >= rt_next) {
		rt_next = rt_next + rt_int;
		start = 1;
		s_note = rt_note;
		s_vel = clamp(rt_vel * (1 + rtrg_vel * rt_cnt / rt_total), 0, 1);
	}
}

if (start > 0.5) {
	hit_note = s_note;
	hit_vel = s_vel;
	t = 0.01 * pow(250, decay);
	t = t * (1 - accent * 0.5 + accent * s_vel);
	coef = exp(-6.9078 / (t * samplerate));
	target = max(env, s_vel);
	att = 1;
	exc = 1;
	pe = 1;
	me_stage = 1;
	if (retrig > 0.5) {
		for (r = 0; r < 8; r += 1) {
			poke(ph, 0, r);
		}
		fb_prev = 0;
	}
	gate_cnt = samplerate * 0.005;
}

// Hüllkurve: RC-Ladekurve mit Überschwing-Ziel, Ausklang mit leichter Krümmung
if (att > 0.5) {
	ov = 1.01 + 0.02 * an;
	env = env + (target * ov - env) * (1 - exp(-4.6 / (attack * 0.001 * samplerate)));
	if (env >= target) {
		env = target;
		att = 0;
	}
} else {
	env = env * pow(coef, 1 - 0.3 * an * (1 - env));
}
exc = exc * 0.992;
if (gate_cnt > 0) {
	gate_cnt = gate_cnt - 1;
}

// Vactrol (Lowpass-Gate): schnell auf, langsam und nichtlinear zu
if (env > vac) {
	vac = vac + (env - vac) * (1 - exp(-1 / (0.002 * samplerate)));
} else {
	tau = 0.012 + 0.25 * (1 - vac) * (1 - vac);
	vac = vac + (env - vac) * (1 - exp(-1 / (tau * samplerate)));
}

pe = pe * exp(-6.9078 / (sweep_time * 0.001 * samplerate));

// Mod-Hüllkurve (AD, optional Loop): linear gerechnet, Ausgabe mit Kurve geformt, skaliert mit der Velocity
if (me_stage > 1.5) {
	me_lin = me_lin - 1 / (menv_dec * 0.001 * samplerate);
	if (me_lin <= 0) {
		me_lin = 0;
		me_stage = 0;
		if (menv_loop > 0.5) {
			me_stage = 1;
		}
	}
} else if (me_stage > 0.5) {
	me_lin = me_lin + 1 / (menv_atk * 0.001 * samplerate);
	if (me_lin >= 1) {
		me_lin = 1;
		me_stage = 2;
	}
}
me_out = me_lin;
if (me_stage > 1.5 || me_stage < 0.5) {
	me_out = mix(me_lin, me_lin * me_lin * me_lin * me_lin, menv_curve);
}
me_v = me_out * (0.5 + 0.5 * hit_vel);
gdrift = peek(dr, 8) * d_norm * drift_c * 0.5;
f0 = mtof(hit_note + sweep * pe + menv_pitch * me_v + gdrift * 0.01) * (1 - sag * 0.012 * sagf);
w = floor(waveform + 0.5);
mw = floor(mod_wave + 0.5);
acc_b = bright * (1 - accent * 0.4 + accent * 0.4 * hit_vel);
ta = clamp(inharm * 2, 0, 1);
tb = clamp(inharm * 2 - 1, 0, 1);
nv = floor(voices + 0.5);
osf = selector(floor(quality + 0.5) + 1, 1, 2, 4);
sr2 = samplerate * osf;
nyq = sr2 * 0.45;
idx = max(0, fm_amt * 2 * env * (1 - accent * 0.4 + accent * 0.4 * hit_vel) + menv_fm * 2 * me_v);
amp = env;
if (amp_mode > 0.5) {
	amp = pow(vac, 1.4);
}
amp_ab = amp + bleed;
lpg_fc = mix(16000, 60 * pow(2, vac * 8.2), lpg_color);
q = mix(400, 12, damp);
fold_e = clamp(wfold + menv_fold * me_v, 0, 1);
fold_g = 1 + fold_e * 5;
// Filter: Cutoff mit Hüllkurve, Key-Tracking (relativ zu C3) und Bauteil-Toleranz
flt_fc = cutoff * pow(2, flt_env * 6 * me_v + key_trk * (hit_note - 60) / 12) * (1 + an * 0.05 * peek(tol, 38));
flt_q = 0.5 + reso * reso * 24;
ft = floor(flt_type + 0.5);
fcirc = floor(flt_circ + 0.5);
flt_dg = 1 + flt_drive * 6;
flt_dgc = 1 / (1 + flt_drive * 3);
// Dirt
dtype = floor(dist_type + 0.5);
d_gain = 1 + dist_drive * dist_drive * 40;
d_tc = 1 - exp(-twopi * min(500 * pow(2, dist_tone * 5.17), sr2 * 0.45) / sr2);
fb_g = fb_amt * fb_amt * 3;
fb_c = 1 - exp(-twopi * min(200 * pow(2, fb_tone * 5.9), sr2 * 0.45) / sr2);
fbd = floor(fb_dest + 0.5);
fb_fm = 0;
if (fbd < 0.5 || fbd > 1.5) {
	fb_fm = fb_g * 0.3;
}
fb_fl = 0;
if (fbd > 0.5) {
	fb_fl = fb_g;
}
s_ratio = 1 + sync * 7;
// Begrenzte Schaltungen vertragen mehr Resonanz
flt_qc = flt_q;
if (fcirc > 0.5) {
	flt_qc = 0.5 + reso * reso * 60;
}
flt_lim = selector(fcirc + 1, 0, 1, 2, 0, 0);
flt_sat = ota;
if (fcirc > 0.5) {
	flt_sat = 0;
}
dg = 1 + drive * 12;
ab = asym * 0.3;

// Frequenz-Faktor pro Oszillator: Toleranz + Drift + Jitter (in Cent)
for (c_i = 0; c_i < 8; c_i += 1) {
	cents = peek(tol, c_i) * tol_c + peek(dr, c_i) * d_norm * drift_c + noise() * jit_c;
	poke(fq, pow(2, cents / 1200), c_i);
	fsl = mix(20000, 5000, an * ag) * (0.85 + 0.3 * peek(tol, c_i + 24));
	poke(slc, 1 - exp(-twopi * min(fsl, nyq) / sr2), c_i);
}

// =====================================================================
// Audio-Kern, läuft osf-mal pro Sample (Oversampling) mit Samplerate sr2
// =====================================================================
out_os = 0;
for (o = 0; o < osf; o += 1) {
	// ---------- Engine A: Oszillator-Bank (6 Oszillatoren) ----------
	bank = 0;
	asum = 0;
	wrap0 = 0;
	for (i = 0; i < 6; i += 1) {
		rh = i + 1;
		rm = selector(i + 1, 1, 1.483, 1.8, 2.546, 2.63, 3.897);
		re = selector(i + 1, 1, 1.593, 2.135, 2.296, 2.917, 3.598);
		ratio = mix(mix(rh, rm, ta), re, tb);
		ratio = 1 + (ratio - 1) * spread;
		ratio = ratio * pow(2, detune * selector(i + 1, 0, 0.7, -0.4, 1, -0.9, 0.3) / 1200);
		if (i > 0 && sync > 0.001) {
			ratio = ratio * (1 + sync * 3);
		}
		inc = min(f0 * ratio * peek(fq, i) / sr2, 0.45);
		p = peek(ph, i);
		if (i < 0.5) {
			wrap0 = p + inc >= 1;
		}
		if (i < nv) {
			amp_i = pow(i + 1, tilt);
			pw_i = clamp(pw + an * 0.08 * peek(tol, i + 8), 0.03, 0.97);
			yo = osc(p, inc, w, pw_i);
			yo = yo + shape_ev * (yo * yo - 0.5) + an * 0.06 * peek(tol, i + 16);
			sl = peek(osl, i);
			sl = sl + (yo - sl) * peek(slc, i);
			poke(osl, sl, i);
			bank = bank + sl * amp_i;
			asum = asum + amp_i;
		}
		np_i = fract(p + inc);
		// Hard Sync: Oszillator 1 setzt die übrigen Bank-Oszillatoren zurück
		if (i > 0 && sync > 0.001 && wrap0 > 0.5) {
			np_i = 0;
		}
		poke(ph, np_i, i);
	}
	bank = bank / asum;
	fca = min(f0 * mix(2, 24, acc_b) * (0.4 + 0.6 * sqrt(env)) * (1 + an * 0.04 * peek(tol, 32)), nyq);
	eng_a = 1.8 * svf(bank, fca, 1.5, sr2, st, 0, 1, ota) + 1.8 * svf(bank, fca, 0.7, sr2, st, 2, 2, ota);

	// ---------- Engine B: FM (linear/exponentiell) + Dioden-Ringmodulator ----------
	pc = peek(ph, 6);
	pm = peek(ph, 7);
	inc_m = min(f0 * fm_ratio * peek(fq, 7) / sr2, 0.45);
	mods = osc(wrap(pm + fm_fb * 0.5 * fb_prev, 0, 1), inc_m, mw, pw);
	mods = mods + shape_ev * (mods * mods - 0.5) + an * 0.06 * peek(tol, 23);
	fb_prev = mods;
	inc_c = min(f0 * peek(fq, 6) / sr2, 0.45);
	sm_new = sm_ph + inc_c;
	sm_wrap = sm_new >= 1;
	sm_ph = fract(sm_new);
	if (sync > 0.001) {
		inc_c = min(inc_c * s_ratio, 0.45);
	}
	fbv = peek(aux, 1);
	car = 0;
	if (fm_mode > 0.5) {
		inc_c = min(inc_c * pow(2, idx * 0.75 * mods + fb_fm * 2 * fbv), 0.45);
		car = osc(pc, inc_c, w, pw);
	} else {
		car = osc(wrap(pc + idx * mods + fb_fm * fbv, 0, 1), inc_c, w, pw);
	}
	cplain = osc(pc, inc_c, w, pw);
	rsig = mix(cplain * mods, diode_ring(cplain, mods), ring_bleed) + ring_bleed * (0.25 * cplain + 0.1 * mods);
	pc_new = fract(pc + inc_c);
	// Hard Sync: Master auf f0 setzt den Träger zurück
	if (sync > 0.001 && sm_wrap > 0.5) {
		pc_new = 0;
	}
	poke(ph, pc_new, 6);
	poke(ph, fract(pm + inc_m), 7);
	eng_b = 1.2 * (car * (1 - ring) + rsig * ring);

	// ---------- Engine C: Modal-Resonator oder Bridged-T (808) ----------
	res = 0;
	if (reso_mode > 0.5) {
		// Bridged-T: kurzer Impuls regt gesättigte Schwingkreise an, Tonhöhe steigt mit der Amplitude
		ex = exc * exc * exc * exc * hit_vel * 20;
		qb = q * 0.5;
		for (j = 0; j < 2; j += 1) {
			mr = selector(j + 1, 1, mix(1.5, 2.3, inharm));
			fr = min(f0 * mr * (1 + 0.08 * bt_amp) * (1 + an * 0.01 * peek(tol, 33 + j)), nyq);
			res = res + svf(ex, fr, qb, sr2, st, 4 + j * 2, 1, 1.5) * qb / (j + 1);
		}
		bt_amp = bt_amp + (abs(res) - bt_amp) * 0.001;
		res = res * 0.5;
	} else {
		ex = noise() * exc * exc * (0.4 + 0.6 * acc_b) * hit_vel;
		for (j = 0; j < 4; j += 1) {
			mh = j + 1;
			mb = selector(j + 1, 1, 2.756, 5.404, 8.933);
			mp = selector(j + 1, 1, 1.594, 2.136, 2.653);
			mr = mix(mix(mh, mb, ta), mp, tb);
			fr = min(f0 * mr * (1 + an * 0.01 * peek(tol, 33 + j)), nyq);
			res = res + svf(ex, fr, q, sr2, st, 4 + j * 2, 1, 0) * sqrt(1000 / fr) / (j + 1);
		}
		res = res * sqrt(q) * 15 * pow(osf, 0.7);
	}
	eng_c = res * min(1, env * 4);

	// ---------- Morph, Noise, Amp (VCA / LPG) ----------
	va = eng_a * amp_ab;
	vb = eng_b * amp_ab;
	m = morph * 2;
	voice = 0;
	if (m < 1) {
		voice = va * cos(m * pi * 0.5) + vb * sin(m * pi * 0.5);
	} else {
		m = m - 1;
		voice = vb * cos(m * pi * 0.5) + eng_c * sin(m * pi * 0.5);
	}
	voice = voice + svf(noise(), min(f0 * 8, nyq), 0.7, sr2, st, 12, 2, 0) * env * noise_mix * sqrt(osf);
	if (amp_mode > 0.5) {
		voice = svf(voice, lpg_fc, 0.6, sr2, st, 14, 0, ota);
	}

	// Feedback-Patch in den Filtereingang (ohne Filter: zurück in Fold und Drive)
	voice = voice + fb_fl * fbv;

	// ---------- Multimode-Filter (vor Fold und Drive) ----------
	if (ft > 0.5) {
		fcl = clamp(flt_fc * pow(2, flt_fm * 4 * mods), 20, nyq);
		g_f = tan(pi * fcl / sr2);
		xin = voice * flt_dg;
		if (fcirc > 2.5) {
			yf = ladder(xin, g_f / (1 + g_f), reso * 4.3, fst, 4, ft, fcirc < 3.5, flt_morph);
		} else {
			yf = svf_lim(xin, g_f, 1 / flt_qc, fst, 0, ft, flt_lim, flt_morph, flt_sat);
			if (fcirc < 0.5 && flt_slope > 0.5) {
				yf = svf_lim(yf, g_f, 1 / 0.7071, fst, 2, ft, 0, flt_morph, 0);
			}
		}
		voice = yf * flt_dgc * selector(fcirc + 1, 1, 0.62, 1, 2.6, 2.4);  // Pegelangleich je Schaltung
	}

	// ---------- Wavefolder + asymmetrische Sättigung ----------
	if (fold_e > 0.001) {
		voice = mix(voice, sin(voice * fold_g * pi * 0.5), min(1, fold_e * 3));
	}
	y = (tanh(dg * (voice + ab)) - tanh(dg * ab)) / sqrt(dg);

	// ---------- Distortion-Stufe (am Ende der Kette) ----------
	if (dtype > 0.5) {
		xd = y * d_gain;
		yd = xd;
		if (dtype < 1.5) {
			// Diode: asymmetrisches Dioden-Paar
			if (xd > 0) {
				yd = 1 - exp(-xd);
			} else {
				yd = -0.7 * (1 - exp(xd / 0.7));
			}
		} else if (dtype < 2.5) {
			// Röhre: asymmetrische weiche Sättigung
			yd = tanh(xd + 0.3) - tanh(0.3);
		} else if (dtype < 3.5) {
			// Fuzz: hart und asymmetrisch, sputtert bei leisen Signalen
			yd = (clamp(xd * 3 + 0.15, -0.8, 1) - 0.15) * min(1, abs(xd) * 8);
		} else if (dtype < 4.5) {
			// Gleichrichter: Oktav-Effekt
			td = tanh(xd);
			yd = 0.35 * td + 0.65 * abs(td);
		} else {
			// Foldback
			yd = sin(xd * pi * 0.5);
		}
		dlp = peek(aux, 0) + (yd - peek(aux, 0)) * d_tc;
		poke(aux, dlp, 0);
		y = mix(y, dlp * 0.6, dist_mix);
	}
	// Feedback-Weg: dieses Sample, begrenzt und gefiltert, wirkt im nächsten Sample
	poke(aux, peek(aux, 1) + (tanh(y * 2) * 0.5 - peek(aux, 1)) * fb_c, 1);

	// ---------- Dezimation: Butterworth 6. Ordnung bei 0.42 * samplerate ----------
	if (osf > 1) {
		y = svf(y, samplerate * 0.42, 0.5176, sr2, st, 16, 0, 0);
		y = svf(y, samplerate * 0.42, 0.7071, sr2, st, 18, 0, 0);
		y = svf(y, samplerate * 0.42, 1.9319, sr2, st, 20, 0, 0);
	}
	out_os = y;
}
y = out_os;

// Koppelkondensator: Hochpass 2. Ordnung bei 25 Hz entfernt Gleichanteil und den
// hüllkurvenabhängigen Thump der asymmetrischen Sättigung
dc_y = svf(y, 25, 0.7071, samplerate, st, 22, 2, 0);

// Bitcrusher: Sample & Hold mit crush_rate, Quantisierung auf crush_bits
if (crush_rate < samplerate * 0.99 || crush_bits < 15.9) {
	cr_ph = cr_ph + min(crush_rate, samplerate) / samplerate;
	if (cr_ph >= 1) {
		cr_ph = cr_ph - floor(cr_ph);
		qlev = pow(2, floor(crush_bits + 0.5) - 1);
		cr_hold = floor(dc_y * qlev + 0.5) / qlev;
	}
	dc_y = cr_hold;
}

// Netzteil-Einbruch: Hüllkurvenfolger auf den Ausgang
sagf = sagf + (abs(dc_y) - sagf) * selector((abs(dc_y) > sagf) + 1, 0.0003, 0.02);
y_out = dc_y * level * (1 - sag * 0.2 * min(1, sagf * 2));

// ---------- Rumble-Bus: dunkler Hall -> Verzerrung -> Tiefpass, geduckt durch den Schlag ----------
if (rmb_send > 0.001) {
	sr44 = samplerate / 44100;
	rt60 = 1 + rmb_decay * 9;
	rin = peek(aux, 2) + (y_out * rmb_send - peek(aux, 2)) * (1 - exp(-twopi * 900 / samplerate));
	poke(aux, rin, 2);
	la = floor(1031 * sr44);
	lb = floor(1327 * sr44);
	lc = floor(1523 * sr44);
	ld = floor(1871 * sr44);
	da = peek(rvb, wrap(rw - la, 0, 8192));
	db = peek(rvb, 8192 + wrap(rw - lb, 0, 8192));
	dcc = peek(rvb, 16384 + wrap(rw - lc, 0, 8192));
	dd = peek(rvb, 24576 + wrap(rw - ld, 0, 8192));
	dmp = 1 - exp(-twopi * 2500 / samplerate);
	da = peek(aux, 3) + (da - peek(aux, 3)) * dmp;
	db = peek(aux, 4) + (db - peek(aux, 4)) * dmp;
	dcc = peek(aux, 5) + (dcc - peek(aux, 5)) * dmp;
	dd = peek(aux, 6) + (dd - peek(aux, 6)) * dmp;
	poke(aux, da, 3);
	poke(aux, db, 4);
	poke(aux, dcc, 5);
	poke(aux, dd, 6);
	// Hadamard-Matrix verteilt die Energie, Verstärkung pro Linie aus der Nachhallzeit
	poke(rvb, rin + pow(0.001, la / (rt60 * samplerate)) * (da + db + dcc + dd) * 0.5, rw);
	poke(rvb, rin + pow(0.001, lb / (rt60 * samplerate)) * (da - db + dcc - dd) * 0.5, 8192 + rw);
	poke(rvb, rin + pow(0.001, lc / (rt60 * samplerate)) * (da + db - dcc - dd) * 0.5, 16384 + rw);
	poke(rvb, rin + pow(0.001, ld / (rt60 * samplerate)) * (da - db - dcc + dd) * 0.5, 24576 + rw);
	rw = rw + 1;
	if (rw >= 8192) {
		rw = 0;
	}
	wet = (da + db + dcc + dd) * 0.5;
	rg = 1 + rmb_drive * 15;
	wet = tanh(wet * rg) / sqrt(rg);
	wet = svf(wet, rmb_lp, 0.7071, samplerate, aux, 7, 0, 0);
	wet = svf(wet, rmb_lp, 0.7071, samplerate, aux, 9, 0, 0);
	y_out = y_out + wet * (1 - rmb_duck * min(1, env * 1.5)) * 0.6;
}

// Grundrauschen (pink) und Brumm
wn = noise();
pk0 = 0.99765 * pk0 + wn * 0.099046;
pk1 = 0.963 * pk1 + wn * 0.2965164;
pk2 = 0.57 * pk2 + wn * 1.0526913;
pink = (pk0 + pk1 + pk2 + wn * 0.1848) * 0.2;
hum_ph = wrap(hum_ph + selector(floor(hum_hz + 0.5) + 1, 50, 60) / samplerate, 0, 1);
hz = sin(twopi * hum_ph) + 0.5 * sin(twopi * 3 * hum_ph) + 0.25 * sin(twopi * 5 * hum_ph);
y_out = y_out + pink * an * (0.00005 + ag * 0.0003) + hz * hum * 0.003;

out1 = y_out;
out2 = env;
out3 = max(cur_step, 0);
out4 = gate_cnt > 0;
