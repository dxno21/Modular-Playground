{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modular-playground/schema/patch.schema.json",
  "title": "Modular-Playground-Patch (gemeinsam für Tool 1 und Tool 2)",
  "type": "object",
  "required": ["format", "version", "name", "modules", "cables"],
  "properties": {
    "format": { "const": "modular-playground.patch" },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance", "module"],
        "properties": {
          "instance": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "row": { "type": "integer", "minimum": 0 },
          "x_hp": { "type": "integer", "minimum": 0 },
          "params": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "cables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/definitions/endpoint" },
          "to": { "$ref": "#/definitions/endpoint" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "required": ["instance", "jack"],
      "properties": {
        "instance": { "type": "string" },
        "jack": { "type": "string" }
      }
    }
  }
}
